  {
   "id": "M3",
   "type": "multi_doc",
   "question": "Why did a fraud model update slow down card authorizations?",
   "expect_status": "answered",
   "status": "answered",
   "answer": "The fraud model update (fraud model v4) added new features for card-not-present transactions (roughly 240 features compared to 90 in version 3), which made the fraud-scorer service significantly slower with an observed p99 latency of about 900 ms. Because the payments-gateway calls the fraud-scorer synchronously and keeps the ledger DB connection open until the authorization completes, this increased latency caused ledger database connections to be held much longer. Combined with a recently reduced ledger DB connection pool, this exhaustion of connections caused new authorizations to wait and eventually hit gateway timeouts.",
   "correct": 1.0,
   "content_correct": 1.0,
   "f1": 0.07920792079207921,
   "citation_precision": 1.0,
   "citation_support": 1.0,
   "latency_s": 0.28,
   "llm_calls": 4,
   "tokens": 9109,
   "cache_hits": 4,
   "providers": [
    "gemini:gemini-3.5-flash-lite"
   ],
   "claims": [
    {
     "text": "Fraud model version 4 added new features for card-not-present transactions, totaling roughly 240 features compared with 90 in version 3.",
     "citations": [
      "incidents:chg-0314-change-request-docx#b1"
     ]
    },
    {
     "text": "The update rolled out via CHG-0314 made fraud-scorer much slower, raising observed p99 latency to about 900 ms.",
     "citations": [
      "incidents:inc-2041-incident-report-pdf#b4"
     ]
    },
    {
     "text": "payments-gateway calls fraud-scorer synchronously and keeps the ledger DB connection open until the authorization completes.",
     "citations": [
      "incidents:inc-2041-incident-report-pdf#b4"
     ]
    },
    {
     "text": "Slow fraud scoring kept ledger DB connections checked out much longer than usual, which exhausted the connection pool and led to gateway timeouts.",
     "citations": [
      "incidents:inc-2041-incident-report-pdf#b4"
     ]
    }
   ],
