# Qdrant Cloud (free cluster): URL including :6333
QDRANT_URL=
QDRANT_API_KEY=
# dev only: embedded local Qdrant instead of a server (e.g. data/cache/qdrant-dev)
# QDRANT_PATH=

# LLMs (OpenAI-compatible endpoints); endpoint order = fallback order
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# protects upload/replace/delete on the public demo (writes are disabled while it is empty or "change-me")
ADMIN_TOKEN=

# eval only: persist LLM responses so re-runs are free and reproducible
# LLM_CACHE_PATH=eval/results/llm.cache.json
